# Current chat designs the candidate; the webpage does not auto-invoke the chat.
# Local deterministic prototype: lets you walk through the full UI without an API key.
CREATE_JUNIOR_AI_PROVIDER=prototype

# For session handoff, use session. For an online model, replace the provider and fill all three fields.
# Use a vision-capable model actually offered by your provider.
# CREATE_JUNIOR_AI_PROVIDER=openai_compatible
# CREATE_JUNIOR_AI_BASE_URL=https://your-provider.example/v1
# CREATE_JUNIOR_AI_API_KEY=your-key
# CREATE_JUNIOR_AI_MODEL=your-vision-model
