# Automatic online design tasks. Keep the API key on the server, never in web/.
# Existing .env files are not overwritten by an update.
CREATE_JUNIOR_AI_PROVIDER=openai
CREATE_JUNIOR_AI_BASE_URL=https://api.openai.com/v1
CREATE_JUNIOR_AI_MODEL=gpt-6.2-astra
CREATE_JUNIOR_AI_API_KEY=

# Alternative OpenAI-compatible service: set provider=openai_compatible,
# its /v1 base URL, a vision-capable model, and its key.
# Manual chat handoff remains available with provider=session.
# Fixed sample mode (legacy endpoint only): provider=prototype.
